# Postgres credentials
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=content_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# API keys for the content sources
TMDB_API_KEY=get_free_key_at_themoviedb.org
SIMKL_CLIENT_ID=get_free_key_at_simkl.com
# SIMKL_CLIENT_SECRET is only needed once, during the initial OAuth
# authorization-code exchange; no running service reads it afterward.
SIMKL_CLIENT_SECRET=get_free_key_at_simkl.com
SIMKL_ACCESS_TOKEN=generated_via_oauth_flow
HARDCOVER_API_TOKEN=get_free_key_at_hardcover.app

# Ollama: local inference, no paid API
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PICKS_MODEL=llama3.2:1b
OLLAMA_ASK_MODEL=llama3.2:3b

# Failed-run email alerts (dagster/sensors.py). Gmail needs an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not the normal
# account password. Leave blank to skip email; failures still show on /health.
ALERT_EMAIL_TO=alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=

# /ask read-only DB access: a separate Postgres role, SELECT-only on
# marts/meta, so a bad agent-written query can never mutate real data.
ASK_DATABASE_URL=postgresql://ask_readonly:your_ask_readonly_password@postgres:5432/content_db
ASK_READONLY_PASSWORD=your_ask_readonly_password
