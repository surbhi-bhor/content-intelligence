    {
      "name": "Total Catalog Size",
      "description": "Total distinct movies and TV shows ingested into the catalog, watched or not.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT COUNT(*) FROM marts.dim_watchable"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B"
      }
    },
    {
      "name": "Last Pipeline Run",
      "description": "Timestamp of the most recent taste profile or recommendation refresh.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT GREATEST((SELECT MAX(generated_at) FROM meta.taste_profile), (SELECT MAX(generated_at) FROM meta.daily_recommendations_watch), (SELECT MAX(generated_at) FROM meta.daily_recommendations_books))"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B"
      }
    },
    {
      "name": "Raw Rows Ingested",
      "description": "Total raw rows currently stored across all 5 source tables: movies, TV, ratings, books, book ratings.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT (SELECT COUNT(*) FROM raw.raw_movies) + (SELECT COUNT(*) FROM raw.raw_tv) + (SELECT COUNT(*) FROM raw.raw_ratings) + (SELECT COUNT(*) FROM raw.raw_books) + (SELECT COUNT(*) FROM raw.raw_book_ratings) + (SELECT COUNT(*) FROM raw.raw_movie_details) + (SELECT COUNT(*) FROM raw.raw_tv_details)"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B"
      }
    }
  ],
