  "cards": [
    {
      "name": "Your Average Rating by Genre",
      "description": "Average personal rating per genre, movies and TV combined. A genre needs at least 2 ratings to appear, so one score can't make or break a category.",
      "display": "row",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "template-tags": [
              {
                "default": null,
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/DateTime",
                    "effective-type": "type/DateTime"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "interaction_date"
                  }
                ],
                "id": "3ea4d216-f1d2-4242-95b4-fc9859795068",
                "name": "date_range",
                "display-name": "Date Range",
                "widget-type": "date/all-options"
              },
              {
                "default": null,
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Text",
                    "effective-type": "type/Text"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "content_type"
                  }
                ],
                "id": "93022aa7-b174-4123-8185-84080930cc4f",
                "name": "content_type",
                "display-name": "Content Type",
                "widget-type": "string/="
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "SELECT dg.genre_name AS \"Genre\", AVG(fact_watch_history.rating) AS \"Avg Rating\", COUNT(*) AS \"Titles Rated\"\nFROM marts.fact_watch_history\nJOIN marts.bridge_content_genre bcg ON bcg.content_id = fact_watch_history.content_id\nJOIN marts.dim_genre dg ON dg.genre_id = bcg.genre_id\nWHERE fact_watch_history.rating IS NOT NULL\n  AND fact_watch_history.consumption_status = 'consumed'\n  [[AND {{content_type}}]]\n  [[AND {{date_range}}]]\nGROUP BY dg.genre_name\nHAVING COUNT(*) >= 2\nORDER BY \"Avg Rating\" DESC"
          }
        ]
      },
      "visualization_settings": {
        "graph.dimensions": [
          "Genre"
        ],
        "series_settings": {
          "Avg Rating": {
            "color": "#06B6D4"
          }
        },
        "graph.show_values": true,
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "graph.series_order": [],
        "column_settings": {
          "[\"name\",\"Avg Rating\"]": {
            "decimals": 2,
            "number_style": "decimal"
          }
        },
        "graph.metrics": [
          "Avg Rating"
        ]
      }
    },
    {
      "name": "Content Consumed Per Month",
      "description": "Count of titles marked consumed, grouped by the month they were watched.",
      "display": "area",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "template-tags": [
              {
                "display-name": "Date Range",
                "default": null,
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/DateTime",
                    "effective-type": "type/DateTime"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "interaction_date"
                  }
                ],
                "id": "3ea4d216-f1d2-4242-95b4-fc9859795068",
                "name": "date_range",
                "widget-type": "date/all-options"
              },
              {
                "display-name": "Content Type",
                "default": null,
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Text",
                    "effective-type": "type/Text"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "content_type"
                  }
                ],
                "id": "93022aa7-b174-4123-8185-84080930cc4f",
                "name": "content_type",
                "widget-type": "string/="
              }
            ],
            "native": "SELECT date_trunc('month', interaction_date) AS \"Month\", COUNT(*) AS \"Items\" FROM marts.fact_watch_history WHERE interaction_date IS NOT NULL AND consumption_status = 'consumed' [[AND {{content_type}}]] [[AND {{date_range}}]] GROUP BY \"Month\" ORDER BY \"Month\""
          }
        ]
      },
      "visualization_settings": {
        "graph.dimensions": [
          "Month"
        ],
        "series_settings": {
          "Items": {
            "color": "#06B6D4"
          }
        },
        "graph.show_values": true,
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "graph.series_order": [],
        "graph.metrics": [
          "Items"
        ]
      }
    },
    {
      "name": "Top Platforms You Watch On",
      "description": "Platforms ranked by number of titles watched on them.",
      "display": "row",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "template-tags": [
              {
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/DateTime",
                    "effective-type": "type/DateTime"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "interaction_date"
                  }
                ],
                "id": "311b5973-70a7-48e0-9b28-88e7fd975ee3",
                "name": "date_range",
                "display-name": "Date Range",
                "default": null,
                "widget-type": "date/all-options"
              },
              {
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Text",
                    "effective-type": "type/Text"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_watch_history",
                    "column": "content_type"
                  }
                ],
                "id": "793840fa-2533-4139-9ec4-fdf31a91a543",
                "name": "content_type",
                "display-name": "Content Type",
                "default": null,
                "widget-type": "string/="
              }
            ],
            "native": "SELECT dp.platform_name AS \"Platform\", COUNT(*) AS \"Items\"\nFROM marts.fact_watch_history\nJOIN marts.bridge_content_platform bcp ON bcp.content_id = fact_watch_history.content_id\nJOIN marts.dim_platform dp ON dp.platform_id = bcp.platform_id\nWHERE dp.platform_name IS NOT NULL\n  AND fact_watch_history.consumption_status = 'consumed'\n  [[AND {{content_type}}]]\n  [[AND {{date_range}}]]\nGROUP BY dp.platform_name\nORDER BY \"Items\" DESC\nLIMIT 10"
          }
        ]
      },
      "visualization_settings": {
        "graph.dimensions": [
          "Platform"
        ],
        "series_settings": {
          "Items": {
            "color": "#06B6D4"
          }
        },
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "graph.series_order": [],
        "graph.metrics": [
          "Items"
        ]
      }
    },
    {
      "name": "Your Average Rating by Book Subject",
      "description": "Average personal rating per book subject tag. A subject needs at least 2 ratings to appear.",
      "display": "row",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "template-tags": [
              {
                "default": null,
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/DateTime",
                    "effective-type": "type/DateTime"
                  },
                  {
                    "schema": "marts",
                    "table": "fact_reading_history",
                    "column": "interaction_date"
                  }
                ],
                "id": "d83864bd-2bb8-4ca3-abe0-3e88e5b13110",
                "name": "date_range",
                "display-name": "Date Range",
                "widget-type": "date/all-options"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "SELECT dbs.subject_name AS \"Subject\", AVG(fact_reading_history.rating) AS \"Avg Rating\", COUNT(*) AS \"Books Rated\"\nFROM marts.fact_reading_history\nJOIN marts.bridge_content_book_subject bcbs ON bcbs.content_id = fact_reading_history.content_id\nJOIN marts.dim_book_subject dbs ON dbs.subject_id = bcbs.subject_id\nWHERE fact_reading_history.rating IS NOT NULL\n  AND fact_reading_history.consumption_status = 'consumed'\n  AND NOT dbs.is_generic\n  [[AND {{date_range}}]]\nGROUP BY dbs.subject_name\nHAVING COUNT(*) >= 2\nORDER BY \"Avg Rating\" DESC"
          }
        ]
      },
      "visualization_settings": {
        "graph.dimensions": [
          "Subject"
        ],
        "series_settings": {
          "Avg Rating": {
            "color": "#06B6D4"
          }
        },
        "graph.show_values": true,
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "graph.series_order": [],
        "column_settings": {
          "[\"name\",\"Avg Rating\"]": {
            "decimals": 2,
            "number_style": "decimal"
          }
        },
        "graph.metrics": [
          "Avg Rating"
        ]
      }
    },
    {
      "name": "Total Unwatched Candidates",
      "description": "Count of catalog items (movies, TV, books) not yet watched or read that meet the recommendation quality bar.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT COUNT(*) AS \"Total Unwatched Candidates\" FROM marts.dim_watchable dw WHERE dw.content_id NOT IN (SELECT content_id FROM marts.fact_watch_history)"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B",
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "series_settings": {},
        "graph.series_order": []
      }
    },
