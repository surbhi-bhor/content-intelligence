    {
      "name": "Most Watched Genre",
      "description": "Genre with the highest number of rated titles, by volume watched, not by average rating.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT g.genre_name FROM marts.dim_genre g JOIN marts.bridge_content_genre bcg ON g.genre_id = bcg.genre_id JOIN marts.fact_watch_history fwh ON bcg.content_id = fwh.content_id GROUP BY g.genre_name ORDER BY COUNT(*) DESC LIMIT 1"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B",
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
          "#8B5CF6"
        ],
        "series_settings": {},
        "graph.series_order": []
      }
    },
    {
      "name": "Unread Books",
      "description": "Books in the catalog with no reading-history record yet.",
      "display": "scalar",
      "type": "question",
      "dataset_query": {
        "lib/type": "mbql/query",
        "database": "Content Pipeline",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "SELECT COUNT(*) FROM marts.book_candidate_scores WHERE content_id NOT IN (SELECT content_id FROM meta.not_interested)"
          }
        ]
      },
      "visualization_settings": {
        "scalar.field": "#F59E0B",
        "graph.colors": [
          "#F59E0B",
          "#06B6D4",
